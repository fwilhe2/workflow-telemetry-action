{
  "name": "workflow-telemetry-action",
  "version": "3.0.0",
  "private": true,
  "description": "Github action to collect metrics (CPU, memory, I/O, etc ...) from your workflows to help you debug and optimize your CI/CD pipeline",
  "main": "dist/main/index.js",
  "scripts": {
    "bundle": "npm run format:write && npm run package",
    "format:write": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "lint": "npx eslint .",
    "package": "npx rimraf ./dist/main ./dist/post ./dist/scw && npx rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "package:watch": "npm run package -- --watch",
    "test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "ci-test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "smoke-test": "tests/smoke-test.sh",
    "all": "npm run format:write && npm run lint && npm run test && npm run package && npm run smoke-test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fwilhe2/workflow-telemetry-action.git"
  },
  "keywords": [
    "monitoring",
    "observability",
    "telemetry",
    "github",
    "actions",
    "workflow",
    "ci-cd"
  ],
  "author": "Florian Wilhelm",
  "license": "Apache-2.0",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@octokit/openapi-types": "^28.0.0",
    "systeminformation": "^5.33.1"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.4.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.0",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.9.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "rollup": "^4.62.4",
    "ts-jest": "^29.4.12",
    "ts-jest-resolver": "^2.0.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "contributors": [
    "Serkan Özal <serkan@thundra.io> (original author)"
  ],
  "homepage": "https://github.com/fwilhe2/workflow-telemetry-action#readme",
  "bugs": {
    "url": "https://github.com/fwilhe2/workflow-telemetry-action/issues"
  }
}
